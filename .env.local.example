# ─── Supabase ───────────────────────────────────────────────────────────────
# Copia este archivo a `.env.local` y rellena los valores con los de tu
# proyecto de Supabase (Project Settings → API).

# URL del proyecto, p.ej. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" — SECRETA. Solo se usa en los scripts de seed (servidor).
# NUNCA la expongas en el navegador ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=
